{
  "name": "rapidfuzz-js",
  "version": "0.6.0",
  "description": "Fast fuzzy string matching for Node.js and the browser",
  "keywords": [
    "damerau-levenshtein",
    "edit-distance",
    "fuzzy",
    "fuzzy-matching",
    "fuzzy-search",
    "fuzzywuzzy",
    "hamming",
    "jaro-winkler",
    "levenshtein",
    "rapidfuzz",
    "similarity",
    "string-matching"
  ],
  "homepage": "https://github.com/sarunast/rapidfuzz-js#readme",
  "bugs": {
    "url": "https://github.com/sarunast/rapidfuzz-js/issues"
  },
  "license": "MIT",
  "author": "Sarunas Tamasauskas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sarunast/rapidfuzz-js.git"
  },
  "files": [
    "dist",
    "!dist/**/*-stats.json"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fuzz": {
      "types": "./dist/fuzz/index.d.ts",
      "import": "./dist/fuzz/index.js"
    },
    "./levenshtein": {
      "types": "./dist/algorithms/levenshtein/index.d.ts",
      "import": "./dist/algorithms/levenshtein/index.js"
    },
    "./indel": {
      "types": "./dist/algorithms/indel/index.d.ts",
      "import": "./dist/algorithms/indel/index.js"
    },
    "./lcs": {
      "types": "./dist/algorithms/lcs/index.d.ts",
      "import": "./dist/algorithms/lcs/index.js"
    },
    "./osa": {
      "types": "./dist/algorithms/osa/index.d.ts",
      "import": "./dist/algorithms/osa/index.js"
    },
    "./damerau-levenshtein": {
      "types": "./dist/algorithms/damerauLevenshtein/index.d.ts",
      "import": "./dist/algorithms/damerauLevenshtein/index.js"
    },
    "./hamming": {
      "types": "./dist/algorithms/hamming/index.d.ts",
      "import": "./dist/algorithms/hamming/index.js"
    },
    "./jaro": {
      "types": "./dist/algorithms/jaro/index.d.ts",
      "import": "./dist/algorithms/jaro/index.js"
    },
    "./jaro-winkler": {
      "types": "./dist/algorithms/jaroWinkler/index.d.ts",
      "import": "./dist/algorithms/jaroWinkler/index.js"
    },
    "./prefix": {
      "types": "./dist/algorithms/prefix/index.d.ts",
      "import": "./dist/algorithms/prefix/index.js"
    },
    "./postfix": {
      "types": "./dist/algorithms/postfix/index.d.ts",
      "import": "./dist/algorithms/postfix/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=lcov --coverage.thresholds.100 --testTimeout=30000 --reporter=default --reporter=junit --outputFile.junit=test-report.junit.xml",
    "bench": "node bench/tooling/runner.ts",
    "bench:quick": "node bench/tooling/runner.ts --quick",
    "bench:memory": "npm run build --silent && node --expose-gc bench/tooling/matcher-memory.ts",
    "bench:memory:scratch": "npm run build --silent && node --expose-gc bench/tooling/scratch-memory.ts",
    "bench:compare": "node bench/tooling/compare.ts",
    "bench:compare:quick": "node bench/tooling/compare.ts --quick",
    "bench:confirm": "node bench/tooling/compare.ts --confirm",
    "bench:baseline": "node bench/tooling/compare.ts --record",
    "bench:libraries": "node bench/comparison/run.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.dev.json && tsc -p tsconfig.scripts.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check:exports": "node scripts/check-exports.mjs",
    "check:bundles": "node scripts/check-bundles.mjs",
    "check:tarball": "node scripts/check-tarball.mjs",
    "check:pkg": "publint && attw --pack . --profile esm-only",
    "check": "npm run build && npm run typecheck && npm run lint && npm run format:check && npm run test && npm run check:exports && npm run check:bundles && npm run check:tarball && npm run check:pkg",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@codecov/rollup-plugin": "2.0.1",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "esbuild": "0.28.1",
    "fast-check": "4.9.0",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "publint": "0.3.23",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.21.0"
}
