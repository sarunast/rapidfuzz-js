{
  "name": "rapidfuzz-js",
  "version": "0.2.0",
  "description": "Fast fuzzy string matching for Node.js and the browser",
  "keywords": [
    "damerau-levenshtein",
    "edit-distance",
    "fuzzy",
    "fuzzy-matching",
    "fuzzy-search",
    "fuzzywuzzy",
    "hamming",
    "jaro-winkler",
    "levenshtein",
    "rapidfuzz",
    "similarity",
    "string-matching"
  ],
  "homepage": "https://github.com/sarunast/rapidfuzz-js#readme",
  "bugs": {
    "url": "https://github.com/sarunast/rapidfuzz-js/issues"
  },
  "license": "MIT",
  "author": "Sarunas Tamasauskas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sarunast/rapidfuzz-js.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fuzz": {
      "types": "./dist/fuzz.d.ts",
      "import": "./dist/fuzz.js"
    },
    "./search": {
      "types": "./dist/search.d.ts",
      "import": "./dist/search.js"
    },
    "./match": {
      "types": "./dist/match.d.ts",
      "import": "./dist/match.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js"
    },
    "./distance": {
      "types": "./dist/distance/index.d.ts",
      "import": "./dist/distance/index.js"
    },
    "./distance/Indel": {
      "types": "./dist/distance/namespaces/Indel.d.ts",
      "import": "./dist/distance/namespaces/Indel.js"
    },
    "./distance/LCSseq": {
      "types": "./dist/distance/namespaces/LCSseq.d.ts",
      "import": "./dist/distance/namespaces/LCSseq.js"
    },
    "./distance/Levenshtein": {
      "types": "./dist/distance/namespaces/Levenshtein.d.ts",
      "import": "./dist/distance/namespaces/Levenshtein.js"
    },
    "./distance/DamerauLevenshtein": {
      "types": "./dist/distance/namespaces/DamerauLevenshtein.d.ts",
      "import": "./dist/distance/namespaces/DamerauLevenshtein.js"
    },
    "./distance/OSA": {
      "types": "./dist/distance/namespaces/OSA.d.ts",
      "import": "./dist/distance/namespaces/OSA.js"
    },
    "./distance/Hamming": {
      "types": "./dist/distance/namespaces/Hamming.d.ts",
      "import": "./dist/distance/namespaces/Hamming.js"
    },
    "./distance/Jaro": {
      "types": "./dist/distance/namespaces/Jaro.d.ts",
      "import": "./dist/distance/namespaces/Jaro.js"
    },
    "./distance/JaroWinkler": {
      "types": "./dist/distance/namespaces/JaroWinkler.d.ts",
      "import": "./dist/distance/namespaces/JaroWinkler.js"
    },
    "./distance/Prefix": {
      "types": "./dist/distance/namespaces/Prefix.d.ts",
      "import": "./dist/distance/namespaces/Prefix.js"
    },
    "./distance/Postfix": {
      "types": "./dist/distance/namespaces/Postfix.d.ts",
      "import": "./dist/distance/namespaces/Postfix.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=lcov --coverage.thresholds.100 --testTimeout=30000",
    "bench": "vitest bench --run",
    "bench:quick": "node bench/run.mjs",
    "bench:compare": "node bench/compare.mjs",
    "bench:compare:quick": "node bench/compare.mjs --quick",
    "bench:baseline": "node bench/compare.mjs --record",
    "bench:libraries": "node bench/comparison/run.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.dev.json && tsc -p tsconfig.scripts.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check:exports": "node scripts/check-exports.mjs",
    "check:pkg": "publint && attw --pack . --profile esm-only",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build && npm run check:exports && npm run check:pkg",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "fast-check": "4.9.0",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "publint": "0.3.23",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.21.0"
}
