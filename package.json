{
  "name": "rapidfuzz-js",
  "version": "0.6.0",
  "description": "Fast fuzzy string matching for Node.js and the browser",
  "keywords": [
    "damerau-levenshtein",
    "edit-distance",
    "fuzzy",
    "fuzzy-matching",
    "fuzzy-search",
    "fuzzywuzzy",
    "hamming",
    "jaro-winkler",
    "levenshtein",
    "rapidfuzz",
    "similarity",
    "string-matching"
  ],
  "homepage": "https://github.com/sarunast/rapidfuzz-js#readme",
  "bugs": {
    "url": "https://github.com/sarunast/rapidfuzz-js/issues"
  },
  "license": "MIT",
  "author": "Sarunas Tamasauskas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sarunast/rapidfuzz-js.git"
  },
  "files": [
    "dist",
    "!dist/**/*-stats.json"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fuzz": {
      "types": "./dist/fuzz.d.ts",
      "import": "./dist/fuzz.js"
    },
    "./levenshtein": {
      "types": "./dist/levenshtein.d.ts",
      "import": "./dist/levenshtein.js"
    },
    "./indel": {
      "types": "./dist/indel.d.ts",
      "import": "./dist/indel.js"
    },
    "./lcs": {
      "types": "./dist/lcs.d.ts",
      "import": "./dist/lcs.js"
    },
    "./osa": {
      "types": "./dist/osa.d.ts",
      "import": "./dist/osa.js"
    },
    "./damerau-levenshtein": {
      "types": "./dist/damerau-levenshtein.d.ts",
      "import": "./dist/damerau-levenshtein.js"
    },
    "./hamming": {
      "types": "./dist/hamming.d.ts",
      "import": "./dist/hamming.js"
    },
    "./jaro": {
      "types": "./dist/jaro.d.ts",
      "import": "./dist/jaro.js"
    },
    "./jaro-winkler": {
      "types": "./dist/jaro-winkler.d.ts",
      "import": "./dist/jaro-winkler.js"
    },
    "./prefix": {
      "types": "./dist/prefix.d.ts",
      "import": "./dist/prefix.js"
    },
    "./postfix": {
      "types": "./dist/postfix.d.ts",
      "import": "./dist/postfix.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=lcov --coverage.thresholds.100 --testTimeout=30000 --reporter=default --reporter=junit --outputFile.junit=test-report.junit.xml",
    "bench": "vitest bench --run",
    "bench:quick": "node bench/run.mjs",
    "bench:compare": "node bench/compare.mjs",
    "bench:compare:quick": "node bench/compare.mjs --quick",
    "bench:baseline": "node bench/compare.mjs --record",
    "bench:libraries": "node bench/comparison/run.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.dev.json && tsc -p tsconfig.scripts.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check:exports": "node scripts/check-exports.mjs",
    "check:pkg": "publint && attw --pack . --profile esm-only",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build && npm run check:exports && npm run check:pkg",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@codecov/rollup-plugin": "2.0.1",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "fast-check": "4.9.0",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "publint": "0.3.23",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.21.0"
}
