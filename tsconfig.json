{
  "compilerOptions": {
    "target": "ES2022",
    // Load-bearing for `engines.node >= 22`: with no `types` and no runtime
    // dependencies, this bound is the whole compatibility guarantee. A stdlib
    // call newer than ES2022 cannot reach src/, and every Node from 18 up
    // implements ES2022 — which is why CI does not also run the suite on the
    // oldest supported Node. Raising this raises the floor in engines too.
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Keep the published source honest about being runtime-neutral. Tests,
    // benchmarks and build tooling add Node globals in tsconfig.dev.json.
    "types": [],

    "strict": true,
    // Off by design: see CLAUDE.md. With it on, every indexed read in the
    // distance DP loops would need a `!` assertion, which the project bans.
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    // Every exported scorer is annotated rather than inferred, so the emitted
    // .d.ts never names an internal `*_impl`. This flag is what keeps it that
    // way, and it lets the bundler generate declarations without a type-check.
    "isolatedDeclarations": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    // `declaration` is on only to satisfy `isolatedDeclarations`, which is a
    // constraint on declaration emit. `noEmit` still means nothing is written;
    // tsdown produces the shipped .d.ts files.
    "declaration": true,
    "noEmit": true
  },
  "include": ["src"]
}
