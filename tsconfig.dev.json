// Node-based development code. Kept separate from the published library so
// `src` cannot accidentally depend on Node globals such as `process` or Buffer.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "resolveJsonModule": true,
    "declaration": false,
    "isolatedDeclarations": false
  },
  "include": ["tests", "bench/**/*.ts", "*.config.ts"]
}
