// The plain-JavaScript tooling: `bench/*.mjs` and `scripts/*.mjs`.
//
// Separate from `tsconfig.json` because these files are checked on different
// terms. They are `.mjs` on purpose — `bench/compare.mjs` sets environment
// variables around a child process, so it cannot be a `.ts` file that needs
// compiling first, and it must stay outside the set `compare.mjs` fingerprints.
// Their types live in JSDoc, checked by `checkJs`.
//
// `isolatedDeclarations` is off here and nowhere else: it constrains declaration
// emit for the published library, and nothing in this project ships a `.d.ts`
// for a build script.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "declaration": false,
    "isolatedDeclarations": false
  },
  "include": ["bench/**/*.mjs", "scripts/**/*.mjs"],
  // `bench/comparison` is excluded because its imports are six fuzzy-matching
  // packages that are deliberately not root devDependencies — they live in
  // `bench/comparison/package.json` and are installed only when the comparison
  // is run. Type-checking that directory would make `pnpm check` fail for
  // every contributor who has not installed them, which is the cost this
  // arrangement exists to avoid. The script loads them through a guarded
  // dynamic import instead, and says what to install when they are missing.
  "exclude": ["bench/comparison"]
}
