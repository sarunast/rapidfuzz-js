// The plain-JavaScript tooling: `scripts/*.mjs`, and `bench/comparison`.
//
// Separate from the TypeScript development config because these files are
// checked on different terms: their types live in JSDoc, checked by `checkJs`.
// They are `.mjs` because each is a shell-invoked entry point, and the ones
// under `scripts/` run against a checkout that may not have built anything.
// The benchmark tooling used to be here for the same reason and no longer is:
// Node executes `bench/tooling/*.ts` directly by stripping the types, so those
// files are checked as TypeScript by `tsconfig.dev.json`.
//
// Like the rest of the development tooling, these scripts do not emit public
// declarations.
{
  "extends": "./tsconfig.dev.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true
  },
  "include": ["bench/**/*.mjs", "scripts/**/*.mjs"],
  // `bench/comparison` is excluded because its imports are six fuzzy-matching
  // packages that are deliberately not root devDependencies — they live in
  // `bench/comparison/package.json` and are installed only when the comparison
  // is run. Type-checking that directory would make `pnpm check` fail for
  // every contributor who has not installed them, which is the cost this
  // arrangement exists to avoid. The script loads them through a guarded
  // dynamic import instead, and says what to install when they are missing.
  "exclude": ["bench/comparison"]
}
